```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.production
.env.development

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Build output
dist/
build/

# Cache
.cache/

# Operating System
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Optional uploads folder (uncomment if uploads are generated at runtime)
# uploads/

# Misc
*.pem
```
